# ── 数据库（本地开发/生产统一用 MySQL） ──
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/karens_agent

# ── 飞书机器人 Webhook URL ──
# 获取方式：飞书群 → 设置 → 群机器人 → 添加 → 获取 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的key

# ── 每天推送时间 ──
PUSH_TIME=09:00

# ── Anthropic API Key（后期智能摘要用） ──
ANTHROPIC_API_KEY=

